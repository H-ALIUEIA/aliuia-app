<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="?attr/actionBarSize"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/menuselector"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center">

        <ScrollView
            android:layout_marginBottom="45dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card"
                    android:tag="prophecies"
                    android:onClick="fragmentreplacer"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1.5"
                    android:layout_margin="8dp"
                    app:cardCornerRadius="20dp">

                    <LinearLayout
                        android:background="@drawable/cardviewcolor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="5"
                            android:gravity="center">

                            <ImageView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:scaleType="fitXY"
                                app:srcCompat="@drawable/prophecyicon4" />

                        </LinearLayout>
                        <TextView
                            android:gravity="center"
                            android:layout_width="match_parent"
                            android:paddingLeft="5dp"
                            app:autoSizeTextType="uniform"
                            android:textColor="@color/white"
                            app:autoSizeMinTextSize="4sp"
                            app:autoSizeMaxTextSize="14sp"
                            app:autoSizeStepGranularity="2sp"
                            android:paddingRight="5dp"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:text="Μάθε της προφητείες της Αγίας Γραφής σε 7 ημέρες"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:gravity="center"
                            android:layout_weight="3">


                            <ImageView
                                android:id="@+id/prophecydaysindicator"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:scaleType="fitXY"
                                app:srcCompat="@drawable/day1" />

                        </LinearLayout>

                        <TextView
                            android:gravity="center"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:textColor="@color/white"
                            app:autoSizeTextType="uniform"
                            app:autoSizeMinTextSize="4sp"
                            app:autoSizeMaxTextSize="12sp"
                            app:autoSizeStepGranularity="2sp"
                            android:text="Δες λεπτομέρειες >"/>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:tag="unlearn"
                    android:onClick="fragmentreplacer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="8dp"
                    android:background="#0000FF"
                    app:cardCornerRadius="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:id="@+id/card3layout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="#0000FF"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <LinearLayout
                                android:orientation="horizontal"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">

                                <LinearLayout
                                    android:layout_gravity="center_vertical"
                                    android:orientation="vertical"
                                    android:layout_width="0dp"
                                    android:layout_weight="1"
                                    android:layout_height="wrap_content">

                                    <TextView
                                        android:textSize="19sp"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Ξέμαθε\nΚοινωνικά Δόγματα"
                                        android:textColor="#FAFAFA"
                                        android:textAppearance="?attr/textAppearanceHeadline6" />

                                </LinearLayout>


                                <LinearLayout
                                    android:gravity="right"
                                    android:layout_weight="1"
                                    android:layout_width="0dp"
                                    android:layout_gravity="center_vertical"
                                    android:layout_height="wrap_content">

                                    <ImageView
                                        android:layout_marginRight="20dp"
                                        android:layout_width="50dp"
                                        android:layout_height="50dp"
                                        android:src="@drawable/open_mind"/>

                                </LinearLayout>

                            </LinearLayout>

                            <TextView
                                android:layout_marginTop="10dp"
                                android:gravity="center"
                                android:paddingLeft="15dp"
                                android:paddingRight="15dp"
                                android:paddingTop="10dp"
                                android:paddingBottom="10dp"
                                android:ellipsize="end"
                                android:singleLine="true"
                                android:scrollHorizontally="false"
                                android:background="@drawable/chip_view_selector"
                                android:layout_width="match_parent"
                                android:layout_height="70dp"
                                android:textSize="20sp"
                                android:text="Ξεκίνα"
                                android:textColor="#00FF00" />

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:tag="unlearn2"
                    android:onClick="fragmentreplacer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="8dp"
                    android:background="#0000FF"
                    app:cardCornerRadius="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:id="@+id/card4layout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="#00FF00"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <LinearLayout
                                android:orientation="horizontal"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">

                                <LinearLayout
                                    android:layout_gravity="center_vertical"
                                    android:orientation="vertical"
                                    android:layout_width="0dp"
                                    android:layout_weight="1"
                                    android:layout_height="wrap_content">

                                    <TextView
                                        android:textSize="19sp"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Άλλες Θρησκείες\n&amp; Δόγματα"
                                        android:textColor="#FAFAFA"
                                        android:textAppearance="?attr/textAppearanceHeadline6" />

                                </LinearLayout>


                                <LinearLayout
                                    android:gravity="right"
                                    android:layout_weight="1"
                                    android:layout_width="0dp"
                                    android:layout_gravity="center_vertical"
                                    android:layout_height="wrap_content">

                                    <ImageView
                                        android:layout_marginRight="20dp"
                                        android:layout_width="50dp"
                                        android:layout_height="50dp"
                                        android:src="@drawable/pray_icon"/>

                                </LinearLayout>

                            </LinearLayout>

                            <TextView
                                android:layout_marginTop="10dp"
                                android:gravity="center"
                                android:paddingLeft="15dp"
                                android:paddingRight="15dp"
                                android:paddingTop="10dp"
                                android:paddingBottom="10dp"
                                android:ellipsize="end"
                                android:singleLine="true"
                                android:scrollHorizontally="false"
                                android:background="@drawable/chip_view_selector"
                                android:layout_width="match_parent"
                                android:layout_height="70dp"
                                android:textSize="20sp"
                                android:text="Ξεκίνα"
                                android:textColor="#00FF00" />

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:tag="unlearn2"
                    android:visibility="gone"
                    android:onClick="fragmentreplacer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="8dp"
                    android:background="#0000FF"
                    app:cardCornerRadius="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:id="@+id/card5layout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="#FF0000"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <LinearLayout
                                android:orientation="horizontal"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">

                                <LinearLayout
                                    android:layout_gravity="center_vertical"
                                    android:orientation="vertical"
                                    android:layout_width="0dp"
                                    android:layout_weight="1"
                                    android:layout_height="wrap_content">

                                    <TextView
                                        android:textSize="19sp"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Αντιχριστιανικά\nΔόγματα"
                                        android:textColor="#FAFAFA"
                                        android:textAppearance="?attr/textAppearanceHeadline6" />

                                </LinearLayout>


                                <LinearLayout
                                    android:gravity="right"
                                    android:layout_weight="1"
                                    android:layout_width="0dp"
                                    android:layout_gravity="center_vertical"
                                    android:layout_height="wrap_content">

                                    <ImageView
                                        android:layout_marginRight="20dp"
                                        android:layout_width="50dp"
                                        android:layout_height="50dp"
                                        android:src="@drawable/antidogma"/>

                                </LinearLayout>

                            </LinearLayout>

                            <TextView
                                android:layout_marginTop="10dp"
                                android:gravity="center"
                                android:paddingLeft="15dp"
                                android:paddingRight="15dp"
                                android:paddingTop="10dp"
                                android:paddingBottom="10dp"
                                android:ellipsize="end"
                                android:singleLine="true"
                                android:scrollHorizontally="false"
                                android:background="@drawable/chip_view_selector"
                                android:layout_width="match_parent"
                                android:layout_height="70dp"
                                android:textSize="20sp"
                                android:text="Ξεκίνα"
                                android:textColor="#00FF00" />

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </ScrollView>

    </LinearLayout>

</LinearLayout>
